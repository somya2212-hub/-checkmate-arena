PORT=5000
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# FIREBASE ADMIN SDK (Backend only - NEVER expose to client/frontend)
# Used by the backend to verify Firebase ID tokens sent in the Authorization header.
# ==============================================================================

# OPTION 1 (Recommended): Individual variables from downloaded service account JSON
FIREBASE_PROJECT_ID=checkmate-arena-dfb15
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@checkmate-arena-dfb15.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# OPTION 2 (Alternative): Full service account JSON as a single-line string or file path
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# OPTION 3 (Alternative): Direct file path to the downloaded JSON key file
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccountKey.json

# ==============================================================================
# OTHER BACKEND CONFIGURATIONS
# ==============================================================================
MONGODB_URI=mongodb://localhost:27017/chess-tournament
JWT_SECRET=your_super_secret_jwt_key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

